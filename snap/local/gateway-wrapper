#!/bin/sh
# Runs the bundled OpenShell gateway for the current user, pinned to the LXD
# compute driver (the lxd-driver service). State lives under
# $SNAP_USER_COMMON, so the desktop app reads the same TLS bundle:
#
#   systemctl --user enable --now snap.openshell-desktop.gateway.service
#
# The port differs from the OpenShell snap's 17670 so both can run. Change it
# with `snap set openshell-desktop gateway-port=...`, and the driver's
# grpc-endpoint to match.
set -eu

tls_dir="${OPENSHELL_LOCAL_TLS_DIR:?OPENSHELL_LOCAL_TLS_DIR is not set}"
state_dir="${SNAP_USER_COMMON}/gateway"
port="$(snapctl get gateway-port)"
: "${port:=17671}"

mkdir -p -m 700 "$state_dir" "$tls_dir"

# Idempotent: keeps an existing TLS and JWT bundle.
"$SNAP/bin/openshell-gateway" generate-certs \
	--output-dir "$tls_dir" \
	--server-san host.openshell.internal

exec "$SNAP/bin/openshell-gateway" \
	--port "$port" \
	--db-url "sqlite:$state_dir/gateway.db?mode=rwc" \
	--compute-driver lxd \
	--compute-driver-socket "$XDG_RUNTIME_DIR/lxd-driver.sock"

#!/bin/sh
# Starts the LXD compute driver with the gateway settings from snap config:
#
#   sudo snap set openshell-desktop grpc-endpoint=https://127.0.0.1:17670
#   sudo snap set openshell-desktop tls-ca=/path/to/ca.crt     # optional
#   sudo snap set openshell-desktop supervisor-network=lxdbr0  # optional
set -eu

endpoint="$(snapctl get grpc-endpoint)"
tls_ca="$(snapctl get tls-ca)"
network="$(snapctl get supervisor-network)"
: "${endpoint:=https://127.0.0.1:17670}"

set -- --socket "$SNAP_COMMON/lxd-driver.sock" \
	--staging-dir "$SNAP_COMMON/staging" \
	--grpc-endpoint "$endpoint"
[ -z "$tls_ca" ] || set -- "$@" --tls-ca "$tls_ca"
[ -z "$network" ] || set -- "$@" --supervisor-network "$network"
exec "$SNAP/bin/openshell-driver-lxd" "$@"
